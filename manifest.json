{
  "schemaVersion": 1,
  "id": "io.github.cfaulkingham.omasnapshot",
  "name": "OmaSnapshot",
  "version": "1.0.0",
  "author": "Colin Faulkingham",
  "license": "MIT",
  "description": "Take a photo or record a video with your webcam from an Omarchy overlay.",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "entryPoints": {
    "overlay": "Overlay.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Camera",
    "description": "Take a photo or record a video with the webcam",
    "category": "Tools",
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "keywords": [
    "webcam",
    "camera",
    "photo",
    "video",
    "capture",
    "microphone"
  ]
}
